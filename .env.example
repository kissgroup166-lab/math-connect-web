# Copy to .env and fill in. Never commit .env.
# Local: run `npm run db:start` and copy the API URL and keys it prints (or `npx supabase status -o env`).
# Production: use your Supabase project's URL and keys (Project Settings → API) as Netlify env vars.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Only used by `npm run admin:create`. The app never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in email links (signup confirmation, password reset).
SITE_URL=http://localhost:3000

# The single admin account, created by `npm run admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Owner

# Brevo SMTP for Supabase auth emails (signup confirmation, password reset).
# The app does not read these. Enter them in Supabase: Project Settings > Authentication > SMTP Settings.
# Get them in Brevo: Settings > SMTP & API > SMTP tab ("Generate a new SMTP key").
# The sender email must be a verified sender in Brevo (Settings > Senders, domains & dedicated IPs).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Your Brevo SMTP login, e.g. 8a1b2c001@smtp-brevo.com (not your account email)
SMTP_USER=
# The SMTP key from Brevo (starts with xsmtpsib-), not the API key (xkeysib-)
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=MathConnect
