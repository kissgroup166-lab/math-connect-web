# Copy to .env and fill in. Never commit .env.
# Local: run `npm run db:start` and copy the API URL and keys it prints (or `npx supabase status -o env`).
# Production: use your Supabase project's URL and keys (Project Settings → API) as Netlify env vars.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Only used by `npm run admin:create`. The app never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in email links (signup confirmation, password reset).
SITE_URL=http://localhost:3000

# The single admin account, created by `npm run admin:create`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site Owner
